# Copy these values into the Apache/PHP environment on your machine.
# Never commit a real API key to Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Email tiếp nhận yêu cầu liên hệ bác sĩ (tùy chọn; cần cấu hình mail/SMTP của PHP)
HEALCARE_CONTACT_EMAIL=
# Admin account (change before production deployment)
HEALCARE_ADMIN_USER=admin
HEALCARE_ADMIN_PASSWORD=change-this-password
